NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ceekay_db
DB_USER=root
DB_PASSWORD=ceekay
DB_SSL=false

# Customer session signing key — long random string, keep secret
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Admin session signing key — MUST be different from JWT_SECRET above
ADMIN_JWT_SECRET=replace_with_a_different_long_random_secret

# Shared secret between server.js and product_scraper.py --bot.
# Generate one (e.g. `openssl rand -hex 32`) and put the same value in
# both this file and the shell environment the bot runs in.
SCRAPER_API_KEY=replace_with_a_random_string

# Used once by `npm run seed-admin` to create your OWNER account.
# You can remove these three lines after running it.
OWNER_EMAIL=braelrotich@gmail.com
OWNER_PASSWORD=ceekay
OWNER_NAME=Store Owner
